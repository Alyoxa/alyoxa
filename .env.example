# Server-only variables. Copy to .env.local and replace these placeholders.
RESEND_API_KEY=
# Use an address on a domain verified in your Resend account.
RESEND_FROM="ALYOXA <hello@alyoxa.com>"

# Optional public search-ownership tokens. Leave blank until supplied by the owner.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Set true only for a deliberately non-indexable deployment. Production defaults to indexable.
SEO_INDEXING_DISABLED=false
# Optional manual IndexNow submission; also publish the matching /<key>.txt ownership file.
INDEXNOW_KEY=
